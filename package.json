{
  "name": "dungeon-master-plugin",
  "version": "0.4.0",
  "description": "D&D campaign tools and skills with durable journal-backed memory",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dungeon-master": "dist/cli.js",
    "dungeon-master-mcp": "dist/server.js"
  },
  "scripts": {
    "journal:setup": "node scripts/setup-project-journal.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:journal": "npm run build && node --test test/integration/real-journal.mjs",
    "example": "node dist/cli.js demo",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "format": "prettier --write src test scripts docs skills *.json *.md .agents .github",
    "format:check": "prettier --check src test scripts docs skills *.json *.md .agents .github"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "0.35.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "journal-rag": "git+https://github.com/neryams/workspace-docs-mcp.git#93de77e54b013800d9ecddbe230840c46d549740"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0"
  }
}
